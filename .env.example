# Copy to .env and adjust as needed. Defaults here match settings.py's
# fallbacks, so the app runs even without a .env at all.
#
# Note: this file also doubles as Docker Compose's project-root .env, which
# Compose auto-loads for its OWN ${VAR} substitution syntax (separate from
# the env_file: pass-through to containers). Avoid unescaped $ and # in
# values here or Compose will silently mangle them.

# Django
SECRET_KEY=django-insecure-HpFzt9x8DqOueaf2n3Qf2jHuap8HKtORYNcAXNEVzUcdkLEUVQ
DEBUG=True
ALLOWED_HOSTS=*

# Database (also consumed directly by the postgres image in docker-compose.yml)
POSTGRES_DB=backend_devops_interview
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
